{
  "ConnectionStrings": {
    "SisalDb": "Server=.\\SQLEXPRESS;Database=SISAL;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sisal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SiSal",
    "Audience": "SiSalClient",
    "Key": "CAMBIA-ESTO-POR-UNA-CLAVE-LARGA-Y-SECRETA-DE-32-CARACTERES-MINIMO",
    "ExpiryMinutes": 30,
    "RefreshTokenExpiryMinutes" : 120
  }
}